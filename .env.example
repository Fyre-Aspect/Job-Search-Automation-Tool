# Example environment file
# Copy to .env and fill in your credentials for local testing
# DO NOT commit .env to the repository!

# Gmail credentials (required)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient email (optional, defaults to GMAIL_USER)
RECIPIENT_EMAIL=your-email@gmail.com

# Adzuna API credentials (optional, for additional job source)
# Get free API key at: https://developer.adzuna.com/
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key
